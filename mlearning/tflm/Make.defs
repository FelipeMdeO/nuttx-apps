ifneq ($(CONFIG_TFLITE_MICRO),)
CONFIGURED_APPS += $(APPDIR)/mlearning/tflm

TFLITE_MICRO_ROOT = $(APPDIR)/mlearning/tflm/tflite-micro

# TF_LITE_STATIC_MEMORY changes struct layouts in public headers, so it
# must be defined for every translation unit that includes TFLM headers,
# not only for the library itself.

TFLITE_MICRO_INCFLAGS = ${INCDIR_PREFIX}$(TFLITE_MICRO_ROOT)
TFLITE_MICRO_INCFLAGS += ${INCDIR_PREFIX}$(TFLITE_MICRO_ROOT)/third_party/flatbuffers/include
TFLITE_MICRO_INCFLAGS += ${INCDIR_PREFIX}$(TFLITE_MICRO_ROOT)/third_party/gemmlowp
TFLITE_MICRO_INCFLAGS += ${INCDIR_PREFIX}$(TFLITE_MICRO_ROOT)/third_party/ruy
TFLITE_MICRO_INCFLAGS += ${INCDIR_PREFIX}$(TFLITE_MICRO_ROOT)/third_party/kissfft

TFLITE_MICRO_DEFINES = -DTF_LITE_STATIC_MEMORY -DTF_LITE_DISABLE_X86_NEON
TFLITE_MICRO_DEFINES += -DTFLITE_WITH_STABLE_ABI=0
TFLITE_MICRO_DEFINES += -DTFLITE_USE_OPAQUE_DELEGATE=0
TFLITE_MICRO_DEFINES += -DTFLITE_ARCH_FLOAT16=0
TFLITE_MICRO_DEFINES += -DTFLITE_SINGLE_ROUNDING=0

CFLAGS += $(TFLITE_MICRO_INCFLAGS) $(TFLITE_MICRO_DEFINES)
CXXFLAGS += $(TFLITE_MICRO_INCFLAGS) $(TFLITE_MICRO_DEFINES)

endif
